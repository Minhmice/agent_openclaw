{
  "$defs": {
    "Confidence": {
      "description": "Confidence assigned to evidence or a derived result.",
      "enum": [
        "high",
        "medium",
        "low"
      ],
      "title": "Confidence",
      "type": "string"
    },
    "StageStatus": {
      "enum": [
        "pending",
        "running",
        "complete",
        "partial",
        "no_candidate_defensible",
        "failed_retryable",
        "failed_terminal",
        "blocked"
      ],
      "title": "StageStatus",
      "type": "string"
    }
  },
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "additionalProperties": false,
  "description": "Resumable structured result emitted by every logical stage.",
  "properties": {
    "attempt_count": {
      "maximum": 5,
      "minimum": 0,
      "title": "Attempt Count",
      "type": "integer"
    },
    "checkpoint": {
      "additionalProperties": true,
      "title": "Checkpoint",
      "type": "object"
    },
    "completed_at": {
      "anyOf": [
        {
          "format": "date-time",
          "type": "string"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "title": "Completed At"
    },
    "confidence": {
      "anyOf": [
        {
          "$ref": "#/$defs/Confidence"
        },
        {
          "maximum": 1,
          "minimum": 0,
          "type": "number"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "title": "Confidence"
    },
    "error_code": {
      "anyOf": [
        {
          "minLength": 1,
          "type": "string"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "title": "Error Code"
    },
    "evidence_ids": {
      "items": {
        "minLength": 1,
        "type": "string"
      },
      "title": "Evidence Ids",
      "type": "array"
    },
    "input_refs": {
      "items": {
        "minLength": 1,
        "type": "string"
      },
      "title": "Input Refs",
      "type": "array"
    },
    "output_refs": {
      "items": {
        "minLength": 1,
        "type": "string"
      },
      "title": "Output Refs",
      "type": "array"
    },
    "producer_role": {
      "minLength": 1,
      "title": "Producer Role",
      "type": "string"
    },
    "reused": {
      "default": false,
      "title": "Reused",
      "type": "boolean"
    },
    "run_id": {
      "minLength": 1,
      "title": "Run Id",
      "type": "string"
    },
    "schema_version": {
      "default": "lead-intelligence.contracts.v1",
      "minLength": 1,
      "title": "Schema Version",
      "type": "string"
    },
    "stage_id": {
      "minLength": 1,
      "title": "Stage Id",
      "type": "string"
    },
    "started_at": {
      "anyOf": [
        {
          "format": "date-time",
          "type": "string"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "title": "Started At"
    },
    "status": {
      "$ref": "#/$defs/StageStatus"
    }
  },
  "required": [
    "stage_id",
    "run_id",
    "producer_role",
    "status",
    "attempt_count",
    "input_refs",
    "output_refs",
    "evidence_ids"
  ],
  "title": "StageOutcome",
  "type": "object"
}
