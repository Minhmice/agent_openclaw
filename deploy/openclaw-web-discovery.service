[Unit]
Description=OpenClaw website discovery run
After=network-online.target openclaw-gateway.service

[Service]
Type=oneshot
EnvironmentFile=%h/.config/openclaw-web/env
Environment=PYTHONUNBUFFERED=1
WorkingDirectory=%h/.local/share/openclaw-web/current
ExecStart=%h/.local/share/openclaw-web/current/venv/bin/openclaw-web cron-run --json
TimeoutStartSec=3h15m
